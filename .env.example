PORT=9000
DB_URI=mongodb://127.0.0.1:27017/spy_app
ENC_KEY=12345678901234567890123456789012
IV_LENGTH=16
ACCESS_ADMIN_TOKEN_SIGNATURE=spy_app_admin_access_token_secret
ACCESS_USER_TOKEN_SIGNATURE=spy_app_user_access_token_secret
ACCESS_TOKEN_EXPIRES_IN=1800
REFRESH_ADMIN_TOKEN_SIGNATURE=spy_app_admin_refresh_token_secret
REFRESH_USER_TOKEN_SIGNATURE=spy_app_user_refresh_token_secret
REFRESH_TOKEN_EXPIRES_IN=31536000
REDIS_URL=redis://localhost:6379
CACHE_TTL=300
WEB_CLIENT_IDS=
# Sender Gmail address and its 16-character Google App Password (not your normal password).
APP_EMAIL=
APP_PASSWORD=
APP_NAME="Spy App"
